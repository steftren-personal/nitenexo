# Vorlage für .env.local — Kopie anlegen und ausfüllen:
#   cp .env.local.example .env.local
# .env.local steht in .gitignore und gehört NIE ins Repository.
# Auf Vercel dieselben Variablen unter Settings → Environment Variables eintragen.

# ── Supabase (Login, Registrierung, Konten) ──────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden — umgeht alle RLS-Regeln, niemals in Browser-Code.
SUPABASE_SERVICE_ROLE_KEY=

# Kommagetrennte Liste der Admin-Adressen (Zugang zu /admin/termine).
ADMIN_EMAILS=

# Öffentliche Basis-URL, z. B. https://nitenexo.at — lokal http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ── Mailversand über SMTP (Kontaktformular + Terminbestätigungen) ────────
# Schritt-für-Schritt-Anleitung: docs/EMAIL-SETUP.md
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Bei Google Workspace ein App-Passwort, nicht das Konto-Passwort.
SMTP_PASS=
# Empfänger der Anfragen, mehrere durch Komma getrennt.
CONTACT_TO=
# Optional: auf "false" setzen, um die Eingangsbestätigung an Absender abzuschalten.
CONTACT_AUTOREPLY=

# ── Google Kalender (Terminbuchung) ──────────────────────────────────────
# Anleitung: docs/GOOGLE-KALENDER-SETUP.md — läuft über OAuth statt Dienstkonto,
# weil Workspace das Erstellen von Dienstkonto-Schlüsseln per Richtlinie sperrt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ── Coming-Soon-Schalter ─────────────────────────────────────────────────
# Auf "true" leitet die Middleware alles auf /coming-soon um; Impressum und
# Datenschutz bleiben erreichbar. Leer oder nicht gesetzt = Seite normal online.
NEXT_PUBLIC_COMING_SOON=
